ANALYTICS_ADMIN_PASSWORD=replace-with-a-long-random-password
# Required for durable Vercel storage. Optional for local development.
DATABASE_URL=postgres://username:password@host/database
# Production cron authentication; generate at least 32 random characters.
CRON_SECRET=replace-with-a-long-random-secret
# Optional manual encrypted exports only: generate 32 random bytes as 64 hex characters.
# BACKUP_ENCRYPTION_KEY=
